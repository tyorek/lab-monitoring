# unbound-health-check configuration
# Install to /etc/unbound-health-check/config

# Technitium admin API (local instance).
# If the console redirects HTTP->HTTPS, use https://127.0.0.1:53443 and,
# for a self-signed cert, set CURL_OPTS="-k".
TECHNITIUM_URL="http://127.0.0.1:5380"
#CURL_OPTS="-k"

# API token file (chmod 600 root:root). Create the token in the Technitium
# web console: Administration -> Sessions -> Create Token.
TOKEN_FILE="/etc/unbound-health-check/token"

# Unbound upstream addresses — IPs only (forwarders are IPs, non-negotiable).
# Space-separated; each address is health-checked and added/removed independently,
# so v4 and v6 of the same box can fail over separately (IPv6 parity, lesson four).
# NOTE: the v6 GUAs live in a delegated prefix — if the ISP re-delegates, update
# them here; until then the script just drops the dead v6 forwarders on its own.
# The last four are the public GCP DoT resolvers ns1/ns2 (853) — metered below.
UPSTREAMS="192.168.15.10 192.168.15.11 fd12:3456:789a:15:be24:11ff:fe4d:4c62 fd12:3456:789a:15:be24:11ff:fe15:71fa 34.174.100.7 8.230.105.255 2600:1901:8140:8c0:: 2600:1901:8140:8c0:0:1::"

# Metered upstreams — cloud resolvers that cost egress $ per query. Probed at most
# once per SLOW_PROBE_INTERVAL (seconds) instead of every 30s cycle; between probes
# the cached state is reused and NO query is sent. Failover for these is
# correspondingly slower (~2x the interval with hysteresis), fine for backup clouds.
SLOW_PROBE_INTERVAL=600
SLOW_UPSTREAMS="34.174.100.7 8.230.105.255 2600:1901:8140:8c0:: 2600:1901:8140:8c0:0:1::"

# Probe name: must be something the Unbounds will actually answer with data.
# (Router lesson: first probe choice was blocklisted. Unbound does full
# recursion, so any stable public name works.)
PROBE_NAME="example.com"

# DoT (DNS-over-TLS). The Unbounds listen ONLY on 853 with real Let's Encrypt
# certs, so the probe must speak TLS and validate the cert. A plaintext :53 probe
# always fails against them — that was the bug this replaces.
DOT_PORT=853

# Per-address certificate name — the SAN on each Unbound's Let's Encrypt cert.
# v4 and v6 of the SAME instance share a cert, so both map to the same name.
# Validation fails (probe = down) if the name doesn't match the SAN, so set these
# to the REAL names on your certs. If a wildcard/shared cert covers both boxes,
# use that one name for all four addresses.
# NOTE: cert names are on the public example.com domain (Let's Encrypt won't
# issue for .local); v4 and v6 of each instance share the instance's cert.
declare -A DOT_TLS_NAME=(
  [192.168.15.10]="secnodetls.example.com"
  [fd12:3456:789a:15:be24:11ff:fe4d:4c62]="secnodetls.example.com"
  [192.168.15.11]="tertnodetls.example.com"
  [fd12:3456:789a:15:be24:11ff:fe15:71fa]="tertnodetls.example.com"
  # public GCP DoT resolvers — SAN presented on their 853 endpoint
  [34.174.100.7]="ns1.example.com"
  [2600:1901:8140:8c0::]="ns1.example.com"
  [8.230.105.255]="ns2.example.com"
  [2600:1901:8140:8c0:0:1::]="ns2.example.com"
)

# Seconds to wait for a probe reply
PROBE_TIMEOUT=2

# Consecutive probes required to flip state (anti-flap hysteresis).
# At a 30s timer: down after ~60s of failures, back after ~60s of recovery.
FAIL_THRESHOLD=2
OK_THRESHOLD=2
